{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1140px",
			"wideSize": "1400px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customDuotone": false,
			"palette": [
				{ "slug": "primary", "name": "Primary Yellow", "color": "#FFF10A" },
				{ "slug": "gold", "name": "Luxury Gold", "color": "#FEC208" },
				{ "slug": "dark-red", "name": "Dark Red", "color": "#CF240A" },
				{ "slug": "orange", "name": "Accent Orange", "color": "#FF2D08" },
				{ "slug": "black", "name": "Black", "color": "#000000" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Poppins",
					"fontFamily": "\"Poppins\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.5rem" },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.5rem" },
				{ "slug": "xx-large", "name": "Huge", "size": "clamp(2.75rem, 6vw, 4.5rem)" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ]
		}
	},
	"styles": {
		"color": {
			"background": "#000000",
			"text": "#FFFFFF"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "#FEC208" },
				":hover": { "color": { "text": "#FFF10A" } }
			},
			"heading": {
				"color": { "text": "#FFFFFF" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.15"
				}
			},
			"button": {
				"color": {
					"background": "#FEC208",
					"text": "#000000"
				},
				"border": { "radius": "14px" },
				"typography": { "fontWeight": "600" },
				":hover": {
					"color": { "background": "#FFF10A", "text": "#000000" }
				}
			}
		}
	}
}
