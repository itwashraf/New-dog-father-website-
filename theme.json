{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "820px",
			"wideSize": "1280px"
		},
		"color": {
			"custom": true,
			"customGradient": true,
			"background": true,
			"text": true,
			"defaultPalette": false,
			"palette": [
				{ "slug": "primary", "color": "#FFF10A", "name": "Primary Yellow" },
				{ "slug": "gold", "color": "#FEC208", "name": "Luxury Gold" },
				{ "slug": "dark-red", "color": "#CF240A", "name": "Dark Red" },
				{ "slug": "orange", "color": "#FF2D08", "name": "Accent Orange" },
				{ "slug": "black", "color": "#000000", "name": "Black" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },
				{ "slug": "surface", "color": "#111114", "name": "Surface" }
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Poppins\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"slug": "heading",
					"name": "Poppins"
				},
				{
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"slug": "body",
					"name": "Inter"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem", "name": "Small" },
				{ "slug": "medium", "size": "1.05rem", "name": "Medium" },
				{ "slug": "large", "size": "1.5rem", "name": "Large" },
				{ "slug": "x-large", "size": "2.4rem", "name": "Extra Large" },
				{ "slug": "huge", "size": "3.4rem", "name": "Huge" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"padding": true,
			"margin": true,
			"blockGap": true
		}
	},
	"styles": {
		"color": {
			"background": "#000000",
			"text": "#FFFFFF"
		},
		"typography": {
			"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
			"fontSize": "17px",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "\"Poppins\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
					"fontWeight": "700"
				},
				"color": { "text": "#FFFFFF" }
			},
			"link": {
				"color": { "text": "#FEC208" },
				":hover": { "color": { "text": "#FFF10A" } }
			},
			"button": {
				"color": { "background": "#FFF10A", "text": "#000000" },
				"border": { "radius": "16px" },
				"typography": { "fontFamily": "\"Poppins\", sans-serif", "fontWeight": "700" }
			}
		}
	}
}
